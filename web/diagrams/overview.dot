digraph overview {
  graph [rankdir=LR, fontname="Helvetica", nodesep=0.35, ranksep=0.5, bgcolor="transparent", pad=0.1];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, color="#868e96", fillcolor="#ffffff", fontcolor="#212529", margin="0.15,0.07"];
  edge  [fontname="Helvetica", fontsize=10, color="#495057", fontcolor="#495057", arrowsize=0.7];
  you   [label="You", shape=box, style="rounded,filled,bold", fillcolor="#fff3bf", color="#e0a800"];
  orch  [label="Orchestrator\n(main session)", fillcolor="#d0ebff", color="#1c7ed6"];
  exp   [label="Explorations", fillcolor="#e9ecef", color="#495057", fontsize=13];
  lit   [label="Literature", fillcolor="#e9ecef", color="#495057", fontsize=13];
  paper [label="Paper", fillcolor="#e9ecef", color="#495057", fontsize=13];
  site  [label="Site", fillcolor="#e9ecef", color="#495057", fontsize=13];
  you -> orch [dir=both];
  orch -> exp; orch -> lit; orch -> paper;
  exp -> paper [label="results"];
  lit -> paper [label="citations"];
  paper -> site;
  site -> you [constraint=false, label="browser"];
}
