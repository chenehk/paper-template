digraph explorations {
  graph [rankdir=LR, fontname="Helvetica", nodesep=0.35, ranksep=0.5, bgcolor="transparent", pad=0.1];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, color="#868e96", fillcolor="#ffffff", fontcolor="#212529", margin="0.15,0.07"];
  edge  [fontname="Helvetica", fontsize=10, color="#495057", fontcolor="#495057", arrowsize=0.7];
  orch   [label="Orchestrator", fillcolor="#d0ebff", color="#1c7ed6"];
  runner [label="exploration-runner", fillcolor="#d3f9d8", color="#2f9e44"];
  sched  [label="scheduler", fillcolor="#d3f9d8", color="#2f9e44"];
  slurm  [label="Slurm\nDelta CPU, DeltaAI GPU", shape=cylinder];
  res    [label="results.json"];
  page   [label="exploration page\ntables, figures"];
  orch -> runner [label="brief"];
  runner -> sched [label="jobs"];
  sched -> slurm;
  runner -> res -> page;
  runner -> orch [style=dashed, label="report", constraint=false];
}
